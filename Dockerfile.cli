# QuicBaaS CLI Dockerfile
# Minimal image containing only the CLI tool

# Build arguments
ARG GO_VERSION=1.27
ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown
# gms_pure_go is the floor, not a feature: this builder is CGO_ENABLED=0 and
# dolthub/go-mysql-server's internal/regex has no file satisfying
# `cgo && !gms_pure_go` without cgo, so the link fails on "build constraints
# exclude all Go files" (see Dockerfile's identical comment). release.yml
# never overrides BUILD_TAGS for this image, so this default is load-bearing.
ARG BUILD_TAGS=gms_pure_go

# Stage 1: Build stage
FROM golang:${GO_VERSION}-alpine AS builder

# Install build dependencies
# file: used by the "Verify static binary" step below (also in Dockerfile's
# apk list, just missing here).
RUN apk add --no-cache git make ca-certificates file

# Set working directory
WORKDIR /build

# Copy module files first for caching
COPY go.mod go.sum ./
COPY sdk/go/go.mod sdk/go/go.sum ./sdk/go/

# Until 2026-08-14 this stage copied working-tree clones out of a .deps/
# directory and rewrote a set of relative `replace` directives to point at
# them (see Dockerfile's identical comment). Both are gone: .deps/ was
# deleted with the decoupling, and the only replaces left in go.mod are the
# intra-repo sdk/go one and an armon/go-metrics version pin, neither of which
# needs rewriting. The COPY of a directory that no longer exists failed the
# build outright.
#
# go.mod pins first-party modules, which this download resolves through the
# module proxy and the checksum database like any other module. Any fetch
# credentials arrive as a BuildKit secret, never a build arg, mounted on tmpfs for this
# RUN alone and never becoming a layer. The mount is optional by design: on
# GitHub Actions no secret is supplied and these modules resolve from the
# public proxy once tags are mirrored (§7), so the same Dockerfile builds on
# both hosts.
RUN --mount=type=secret,id=gomodauth \
    set -eu; \
    if [ -f /run/secrets/gomodauth ]; then . /run/secrets/gomodauth; fi; \
    go mod download

# Copy source code
COPY . .

# Build arguments
ARG VERSION
ARG COMMIT
ARG DATE
ARG BUILD_TAGS

# Build static CLI binary using downloaded dependencies
RUN CGO_ENABLED=0 GOOS=linux go build -mod=mod -tags "${BUILD_TAGS}" -buildvcs=false \
    -ldflags="-w -s -X github.com/jeremyhahn/go-quicbaas/pkg/version.Version=${VERSION} -X github.com/jeremyhahn/go-quicbaas/pkg/version.BuildTime=${DATE} -X github.com/jeremyhahn/go-quicbaas/pkg/version.GitCommit=${COMMIT}" \
    -o quicbaas ./cmd/quicbaas

# Verify static binary
RUN file quicbaas

# Stage 2: Minimal runtime stage
#
# Pinned base plus `apk upgrade`, for the reasons spelled out in the main
# Dockerfile's runtime stage: the pin makes the image reproducible, and the
# upgrade is what lets a patched package reach it between base releases.
# Keep the two files' pins in step — they are the same base.
FROM alpine:3.24.1

# Install minimal runtime dependencies, patched (see the main Dockerfile:
# 3.24.1 ships libcrypto3/libssl3 3.5.7-r0 with CVE-2026-14456).
RUN apk upgrade --no-cache && \
    apk --no-cache add ca-certificates

# Create non-root user
RUN addgroup -g 1000 quicbaas && \
    adduser -D -u 1000 -G quicbaas quicbaas

# Copy binary from builder
COPY --from=builder /build/quicbaas /usr/local/bin/quicbaas

# Set ownership
RUN chown quicbaas:quicbaas /usr/local/bin/quicbaas

# Switch to non-root user
USER quicbaas

# Set working directory
WORKDIR /home/quicbaas

# Entry point - the CLI
ENTRYPOINT ["quicbaas"]

# Default command - show help
CMD ["--help"]

# Labels
LABEL org.opencontainers.image.title="QuicBaaS CLI" \
      org.opencontainers.image.description="QuicBaaS command-line client" \
      org.opencontainers.image.vendor="QuicBaaS" \
      org.opencontainers.image.licenses="Apache-2.0"

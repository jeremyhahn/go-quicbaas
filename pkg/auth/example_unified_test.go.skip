// Package auth demonstrates the unified auth manager with automatic storage detection
package auth_test

import (
	"context"
	"fmt"
	"log"
	"time"

	"github.com/jeremyhahn/go-quicbaas/pkg/auth"
	"github.com/jeremyhahn/go-quicbaas/pkg/logger"
	"github.com/jeremyhahn/go-quicbaas/pkg/storage/memory"
)

// Example_unifiedAuthManager demonstrates automatic storage detection
func Example_unifiedAuthManager() {
	// Create logger
	log, _ := logger.New(logger.LogConfig{
		Level:  "info",
		Format: "text",
		Output: "stdout",
	})

	// === IN-MEMORY MODE ===
	// When storage is nil or memory.MemoryStorage, auth is ephemeral
	memStorage := memory.New(log)
	defer memStorage.Close()

	authConfig := &auth.AuthConfig{
		Enabled:         true,
		JWTSecret:       "test-secret-key-32-chars-min",
		TokenTTL:        1 * time.Hour,
		RefreshTokenTTL: 7 * 24 * time.Hour,
	}

	// Creates in-memory auth automatically
	authManager, err := auth.NewAuthManager(authConfig, memStorage, log)
	if err != nil {
		log.Fatal(err)
	}

	// Bootstrap creates admin user (ephemeral)
	result, err := auth.MustBootstrap(authManager, &auth.BootstrapConfig{
		CreateAdminUser: true,
	})
	if err != nil {
		log.Fatal(err)
	}

	fmt.Printf("Mode: %s\n", result.Message)
	fmt.Printf("Admin created: %v\n", result.AdminUserCreated)

	// Use auth manager (works the same for both modes)
	ctx := context.Background()

	// Type assert to access methods (both types have same interface)
	if am, ok := authManager.(*auth.InMemoryAuthManager); ok {
		// Create user
		user, _ := am.CreateUser("alice", "password123", []string{"readwrite"})
		fmt.Printf("Created user: %s\n", user.Username)

		// Authenticate
		token, _ := am.Authenticate(ctx, "alice", "password123")
		fmt.Printf("Token type: %s\n", token.TokenType)

		// Authorize
		err := am.Authorize(ctx, token.AccessToken, "keys", "write")
		fmt.Printf("Authorized to write keys: %v\n", err == nil)
	}

	// Output:
	// Mode: In-memory admin user created (ephemeral - lost on restart)
	// Admin created: true
	// Created user: alice
	// Token type: Bearer
	// Authorized to write keys: true
}

// Example_persistentAuthManager demonstrates persistent storage mode
func Example_persistentAuthManager() {
	// Create logger
	log, _ := logger.New(logger.LogConfig{
		Level:  "info",
		Format: "text",
	})

	// === PERSISTENT MODE ===
	// When storage is pebble/embedded/cluster, auth persists to database
	// For this example, we'll show the code structure

	authConfig := &auth.AuthConfig{
		Enabled:         true,
		JWTSecret:       "production-secret-key-change-me",
		TokenTTL:        1 * time.Hour,
		RefreshTokenTTL: 7 * 24 * time.Hour,
	}

	// In real code with persistent storage:
	// storage, _ := pebble.New(pebble.Config{DataDir: "./data"}, log)
	// authManager, _ := auth.NewAuthManager(authConfig, storage, log)
	//
	// This would automatically detect persistent storage and use
	// PersistentAuthManager which saves users/roles/tokens to database

	// Bootstrap only runs once (checks __quicbaas:bootstrap:complete)
	// result, _ := auth.MustBootstrap(authManager, &auth.BootstrapConfig{
	//     CreateAdminUser: true,
	// })
	//
	// if result.AdminPassword != "" {
	//     log.Printf("SAVE THIS PASSWORD: %s", result.AdminPassword)
	// }

	fmt.Println("Persistent mode uses database-backed auth")
	fmt.Println("Users survive server restarts")
	fmt.Println("Works across cluster nodes via Raft")

	// Output:
	// Persistent mode uses database-backed auth
	// Users survive server restarts
	// Works across cluster nodes via Raft
}

// Example_storageDetection shows how storage type is detected
func Example_storageDetection() {
	log, _ := logger.New(logger.Default())

	// Memory storage
	memStorage := memory.New(log)
	isMemory := auth.IsMemoryOnlyMode(memStorage)
	fmt.Printf("Memory storage is memory-only: %v\n", isMemory)

	// Nil storage (also treated as memory-only)
	isMemory = auth.IsMemoryOnlyMode(nil)
	fmt.Printf("Nil storage is memory-only: %v\n", isMemory)

	// Any persistent storage (pebble, embedded, cluster) would return false
	fmt.Println("Persistent storage backends automatically use database auth")

	// Output:
	// Memory storage is memory-only: true
	// Nil storage is memory-only: true
	// Persistent storage backends automatically use database auth
}

		}

		err := h.manager.UpdateLocationStatus(h.ctx, entry.Key, "s3-primary", LocationStatus("invalid"))
		if err == nil {
			t.Fatal("expected error for invalid status")
		}
		if !errors.Is(err, ErrInvalidLocationStatus) {
			t.Errorf("expected ErrInvalidLocationStatus, got: %v", err)
		}
	})
}

// TestCatalogManagerListByStore tests listing by store.
func TestCatalogManagerListByStore(t *testing.T) {
	h := newTestHelper(t)
	defer h.cleanup()

	// Create test entries
	for i := 0; i < 5; i++ {
		entry := h.createTestEntry("tenant-test:store-test/file" + itoa(int64(i)) + ".txt")
		if err := h.manager.Put(h.ctx, entry); err != nil {
			t.Fatalf("Put failed: %v", err)
		}
	}

	t.Run("list all", func(t *testing.T) {
		entries, err := h.manager.ListByStore(h.ctx, "s3-primary", nil)
		if err != nil {
			t.Fatalf("ListByStore failed: %v", err)
		}

		if len(entries) != 5 {
			t.Errorf("expected 5 entries, got %d", len(entries))
		}
	})

	t.Run("with limit", func(t *testing.T) {
		entries, err := h.manager.ListByStore(h.ctx, "s3-primary", &ListOptions{Limit: 3})
		if err != nil {
			t.Fatalf("ListByStore failed: %v", err)
		}

		if len(entries) != 3 {
			t.Errorf("expected 3 entries, got %d", len(entries))
		}
	})

	t.Run("empty store", func(t *testing.T) {
		_, err := h.manager.ListByStore(h.ctx, "", nil)
		if err == nil {
			t.Fatal("expected error for empty store")
		}
		if !errors.Is(err, ErrStoreNameEmpty) {
			t.Errorf("expected ErrStoreNameEmpty, got: %v", err)
		}
	})
}


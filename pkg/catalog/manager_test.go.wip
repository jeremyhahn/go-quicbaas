// TestCatalogManagerEnqueueReplication tests replication queue operations.
func TestCatalogManagerEnqueueReplication(t *testing.T) {
	t.Run("success", func(t *testing.T) {
		h := newTestHelper(t)
		defer h.cleanup()

		err := h.manager.EnqueueReplication(h.ctx, "tenant-test:replicate/file.txt", []string{"gcs-backup", "azure-cold"}, 5)
		if err != nil {
			t.Fatalf("EnqueueReplication failed: %v", err)
		}

		task, err := h.manager.DequeueReplication(h.ctx)
		if err != nil {
			t.Fatalf("DequeueReplication failed: %v", err)
		}

		if task == nil {
			t.Fatal("expected non-nil task")
		}
		if task.Key != "tenant-test:replicate/file.txt" {
			t.Errorf("expected key 'tenant-test:replicate/file.txt', got '%s'", task.Key)
		}
		if len(task.Targets) != 2 {
			t.Errorf("expected 2 targets, got %d", len(task.Targets))
		}
	})

	t.Run("empty key", func(t *testing.T) {
		h := newTestHelper(t)
		defer h.cleanup()

		err := h.manager.EnqueueReplication(h.ctx, "", []string{"gcs-backup"}, 5)
		if err == nil {
			t.Fatal("expected error for empty key")
		}
	})

	t.Run("empty targets", func(t *testing.T) {
		h := newTestHelper(t)
		defer h.cleanup()

		err := h.manager.EnqueueReplication(h.ctx, "tenant-test:replicate/file.txt", nil, 5)
		if err == nil {
			t.Fatal("expected error for empty targets")
		}
		if !errors.Is(err, ErrTargetsEmpty) {
			t.Errorf("expected ErrTargetsEmpty, got: %v", err)
		}
	})

	t.Run("empty queue", func(t *testing.T) {
		h := newTestHelper(t)
		defer h.cleanup()

		task, err := h.manager.DequeueReplication(h.ctx)
		if err != nil {
			t.Fatalf("DequeueReplication failed: %v", err)
		}
		if task != nil {
			t.Error("expected nil task for empty queue")
		}
	})
}


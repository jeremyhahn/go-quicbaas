	h := newTestHelper(t)
	defer h.cleanup()

	// Create entries for different tenants
	for i := 0; i < 3; i++ {
		entry := h.createTestEntry("tenant-a:files/file" + itoa(int64(i)) + ".txt")
		entry.TenantID = "tenant-a"
		if err := h.manager.Put(h.ctx, entry); err != nil {

// TestCatalogManagerGetTenantUsage tests tenant usage statistics.
func TestCatalogManagerGetTenantUsage(t *testing.T) {
	h := newTestHelper(t)
	defer h.cleanup()

	// Create test entries
	for i := 0; i < 5; i++ {
		entry := h.createTestEntry("tenant-usage:usage/file" + itoa(int64(i)) + ".txt")
		entry.TenantID = "tenant-usage"
		entry.Size = 1024
		if err := h.manager.Put(h.ctx, entry); err != nil {
			t.Fatalf("Put failed: %v", err)
		}
	}

	t.Run("success", func(t *testing.T) {
		usage, err := h.manager.GetTenantUsage(h.ctx, "tenant-usage")
		if err != nil {
			t.Fatalf("GetTenantUsage failed: %v", err)
		}

		if usage.TenantID != "tenant-usage" {
			t.Errorf("expected tenant 'tenant-usage', got '%s'", usage.TenantID)
		}
		if usage.ObjectCount != 5 {
			t.Errorf("expected 5 objects, got %d", usage.ObjectCount)
		}
		if usage.TotalBytes != 5*1024 {
			t.Errorf("expected %d bytes, got %d", 5*1024, usage.TotalBytes)
		}
	})

	t.Run("empty tenant", func(t *testing.T) {
		_, err := h.manager.GetTenantUsage(h.ctx, "")
		if err == nil {
			t.Fatal("expected error for empty tenant")
		}
		if !errors.Is(err, ErrTenantEmpty) {
			t.Errorf("expected ErrTenantEmpty, got: %v", err)
		}
	})
}

// TestCatalogManagerGetStoreUsage tests store usage statistics.
func TestCatalogManagerGetStoreUsage(t *testing.T) {
	h := newTestHelper(t)
	defer h.cleanup()

	// Create test entries
	for i := 0; i < 3; i++ {
		entry := h.createTestEntry("tenant-store:usage/file" + itoa(int64(i)) + ".txt")
		entry.TenantID = "tenant-store"
		entry.Size = 1024
		entry.PrimaryStore.StoredSize = 512 // Compressed
		if err := h.manager.Put(h.ctx, entry); err != nil {
			t.Fatalf("Put failed: %v", err)
		}
	}

	t.Run("success", func(t *testing.T) {
		usage, err := h.manager.GetStoreUsage(h.ctx, "s3-primary")
		if err != nil {
			t.Fatalf("GetStoreUsage failed: %v", err)
		}

		if usage.StoreName != "s3-primary" {
			t.Errorf("expected store 's3-primary', got '%s'", usage.StoreName)
		}
		if usage.ObjectCount != 3 {
			t.Errorf("expected 3 objects, got %d", usage.ObjectCount)
		}
		if usage.TotalBytes != 3*512 {
			t.Errorf("expected %d bytes, got %d", 3*512, usage.TotalBytes)
		}
	})

	t.Run("empty store", func(t *testing.T) {
		_, err := h.manager.GetStoreUsage(h.ctx, "")
		if err == nil {
			t.Fatal("expected error for empty store")
		}
		if !errors.Is(err, ErrStoreNameEmpty) {
			t.Errorf("expected ErrStoreNameEmpty, got: %v", err)
		}
	})
}

// TestCatalogManagerUpdateAccessTime tests updating access time.
func TestCatalogManagerUpdateAccessTime(t *testing.T) {
	h := newTestHelper(t)
	defer h.cleanup()

	entry := h.createTestEntry("tenant-test:access/file.txt")
	if err := h.manager.Put(h.ctx, entry); err != nil {
		t.Fatalf("Put failed: %v", err)
	}

	// Get original access time
	original, _ := h.manager.Get(h.ctx, entry.Key)
	originalAccess := original.LastAccessAt

	time.Sleep(10 * time.Millisecond)

	if err := h.manager.UpdateAccessTime(h.ctx, entry.Key); err != nil {
		t.Fatalf("UpdateAccessTime failed: %v", err)
	}

	updated, _ := h.manager.Get(h.ctx, entry.Key)
	if updated.LastAccessAt <= originalAccess {
		t.Error("LastAccessAt should have been updated")
	}
}

// TestCatalogManagerClose tests the Close operation.
func TestCatalogManagerClose(t *testing.T) {
	t.Run("success", func(t *testing.T) {
		h := newTestHelper(t)
		defer h.storage.Close()

		err := h.manager.Close()
		if err != nil {
			t.Fatalf("Close failed: %v", err)
		}
	})

	t.Run("double close", func(t *testing.T) {
		h := newTestHelper(t)
		defer h.storage.Close()

		if err := h.manager.Close(); err != nil {
			t.Fatalf("first Close failed: %v", err)
		}

		err := h.manager.Close()
		if err == nil {
			t.Fatal("expected error for double close")
		}
		if !IsCatalogClosed(err) {
			t.Errorf("expected catalog closed error, got: %v", err)
		}
	})
}

// TestCatalogManagerSync tests the Sync operation.
func TestCatalogManagerSync(t *testing.T) {
	h := newTestHelper(t)
	defer h.cleanup()

	entry := h.createTestEntry("tenant-test:sync/file.txt")
	if err := h.manager.Put(h.ctx, entry); err != nil {
		t.Fatalf("Put failed: %v", err)
	}

	if err := h.manager.Sync(); err != nil {
		t.Fatalf("Sync failed: %v", err)
	}
}

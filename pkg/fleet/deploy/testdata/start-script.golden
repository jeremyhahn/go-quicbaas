#!/bin/sh
# QuicBaaS agent launcher (nohup fallback).
# Generated by pkg/fleet/deploy; do not edit by hand.
set -eu
mkdir -p "$HOME"'/.quicbaas/agent'
if [ -f "$HOME"'/.quicbaas/agent/agent.pid' ]; then
  OLDPID=$(cat "$HOME"'/.quicbaas/agent/agent.pid' 2>/dev/null || true)
  if [ -n "${OLDPID:-}" ] && kill -0 "$OLDPID" 2>/dev/null; then
    kill "$OLDPID" || true
    sleep 1
    kill -0 "$OLDPID" 2>/dev/null && kill -9 "$OLDPID" || true
  fi
  rm -f "$HOME"'/.quicbaas/agent/agent.pid'
fi
nohup "$HOME"'/.quicbaas/bin/quicbaas' fleet serve --config "$HOME"'/.quicbaas/bin/agent.yaml' >> "$HOME"'/.quicbaas/agent/agent.log' 2>&1 &
echo $! > "$HOME"'/.quicbaas/agent/agent.pid'

package rest

import (
	"net/http"
	"net/http/httptest"
	"testing"

	"github.com/stretchr/testify/assert"
)

func TestRespondWithCodec_JSON(t *testing.T) {
	rec := httptest.NewRecorder()
	req := httptest.NewRequest(http.MethodGet, "/test", nil)

	data := map[string]interface{}{
		"id":   123,
		"name": "test",
	}

	RespondWithCodec(rec, req, http.StatusOK, data, "json")

	assert.Equal(t, http.StatusOK, rec.Code)
	assert.Equal(t, "application/json", rec.Header().Get("Content-Type"))
	assert.Equal(t, "json", rec.Header().Get("X-QuicBaaS-Codec"))
	assert.Contains(t, rec.Body.String(), "test")
}

func TestRespondWithCodec_YAML(t *testing.T) {
	rec := httptest.NewRecorder()
	req := httptest.NewRequest(http.MethodGet, "/test", nil)

	data := map[string]interface{}{
		"id":   456,
		"name": "yaml-test",
	}

	RespondWithCodec(rec, req, http.StatusCreated, data, "yaml")

	assert.Equal(t, http.StatusCreated, rec.Code)
	assert.Equal(t, "application/x-yaml", rec.Header().Get("Content-Type"))
	assert.Equal(t, "yaml", rec.Header().Get("X-QuicBaaS-Codec"))
	// Currently falls back to JSON encoding
	assert.Contains(t, rec.Body.String(), "yaml-test")
}

func TestRespondWithCodec_MsgPack(t *testing.T) {
	rec := httptest.NewRecorder()
	req := httptest.NewRequest(http.MethodGet, "/test", nil)

	data := map[string]interface{}{
		"id":   789,
		"name": "msgpack-test",
	}

	RespondWithCodec(rec, req, http.StatusAccepted, data, "msgpack")

	assert.Equal(t, http.StatusAccepted, rec.Code)
	assert.Equal(t, "application/msgpack", rec.Header().Get("Content-Type"))
	assert.Equal(t, "msgpack", rec.Header().Get("X-QuicBaaS-Codec"))
	// Currently falls back to JSON encoding
	assert.Contains(t, rec.Body.String(), "msgpack-test")
}

func TestRespondWithCodec_UnknownCodec(t *testing.T) {
	rec := httptest.NewRecorder()
	req := httptest.NewRequest(http.MethodGet, "/test", nil)

	data := map[string]string{
		"message": "unknown codec test",
	}

	RespondWithCodec(rec, req, http.StatusOK, data, "unknown")

	assert.Equal(t, http.StatusOK, rec.Code)
	assert.Equal(t, "application/octet-stream", rec.Header().Get("Content-Type"))
	assert.Equal(t, "unknown", rec.Header().Get("X-QuicBaaS-Codec"))
	assert.Contains(t, rec.Body.String(), "unknown codec test")
}

func TestRespondWithCodec_InvalidData(t *testing.T) {
	rec := httptest.NewRecorder()
	req := httptest.NewRequest(http.MethodGet, "/test", nil)

	// Create circular reference that can't be JSON marshaled
	type circular struct {
		Self *circular
	}
	c := &circular{}
	c.Self = c

	RespondWithCodec(rec, req, http.StatusOK, c, "json")

	// Status code is written before encoding, so it will be 200
	assert.Equal(t, http.StatusOK, rec.Code)
	// Body will be empty or partial due to encoding error
}

func TestRespondWithCodec_MultipleDataTypes(t *testing.T) {
	testCases := []struct {
		name string
		data interface{}
	}{
		{"String", "simple string"},
		{"Int", 42},
		{"Float", 3.14},
		{"Bool", true},
		{"Slice", []int{1, 2, 3}},
		{"Map", map[string]int{"a": 1, "b": 2}},
		{"Struct", struct {
			Name  string
			Value int
		}{"test", 100}},
		{"Nil", nil},
	}

	for _, tc := range testCases {
		t.Run(tc.name, func(t *testing.T) {
			rec := httptest.NewRecorder()
			req := httptest.NewRequest(http.MethodGet, "/test", nil)

			RespondWithCodec(rec, req, http.StatusOK, tc.data, "json")

			assert.Equal(t, http.StatusOK, rec.Code)
			assert.NotEmpty(t, rec.Body.String())
		})
	}
}

func TestRespondWithCodec_AllCodecsWithStruct(t *testing.T) {
	type TestData struct {
		ID   int    `json:"id" yaml:"id"`
		Name string `json:"name" yaml:"name"`
	}

	data := TestData{ID: 123, Name: "test"}
	codecs := []string{"json", "yaml", "msgpack", "unknown"}

	for _, codec := range codecs {
		t.Run(codec, func(t *testing.T) {
			rec := httptest.NewRecorder()
			req := httptest.NewRequest(http.MethodGet, "/test", nil)

			RespondWithCodec(rec, req, http.StatusOK, data, codec)

			assert.Equal(t, http.StatusOK, rec.Code)
			assert.Equal(t, codec, rec.Header().Get("X-QuicBaaS-Codec"))
		})
	}
}

func TestGetLogger_ReturnsNil(t *testing.T) {
	req := httptest.NewRequest(http.MethodGet, "/test", nil)
	logger := getLogger(req)
	assert.Nil(t, logger, "getLogger should return nil in current implementation")
}

func BenchmarkDetectPreferredCodec_Query(b *testing.B) {
	req := httptest.NewRequest(http.MethodGet, "/test?codec=json", nil)

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		detectPreferredCodec(req)
	}
}

func BenchmarkDetectPreferredCodec_Header(b *testing.B) {
	req := httptest.NewRequest(http.MethodGet, "/test", nil)
	req.Header.Set("Accept", "application/json")

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		detectPreferredCodec(req)
	}
}

func BenchmarkRespondWithCodec_JSON(b *testing.B) {
	data := map[string]interface{}{
		"id":   123,
		"name": "benchmark",
		"tags": []string{"test", "benchmark"},
	}

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		rec := httptest.NewRecorder()
		req := httptest.NewRequest(http.MethodGet, "/test", nil)
		RespondWithCodec(rec, req, http.StatusOK, data, "json")
	}
}

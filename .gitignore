# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Output of the go coverage tool
*.out
coverage.txt
coverage.html

# Go workspace file
go.work

# Dependency directories
vendor/

# Build artifacts
/bin/
/build/
/dist/
*.tar.gz

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Local agent-tooling state. None of this is source and all of it leaks the
# machine it was produced on: the NFS-mount symlink at the repo root, a
# per-machine Claude permission allowlist, FUSE orphans the mount leaves
# behind, and opencode's SQLite sidecar files. All seven were tracked until
# go-quicbaas#944; nothing here may return.
/go-quicbaas
SESSION_RESUME.md
.claude/settings.local.json
.claude/.fuse_hidden*
.opencode/*.db*

# Data directories
/data/
*.db
*.log

# Configuration files with secrets
config.local.yml
config.local.yaml
config.local.json
*.secret
*.key
*.pem
*.crt

# Debug and profiling
*.prof
*.pprof
cpu.prof
mem.prof
trace.out

# OS specific
Thumbs.db
ehthumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Docker volumes
.docker-data/

# Test artifacts
test/data/
test/tmp/

# Benchmark artifacts
test/benchmark/results/
test/benchmark/profiles/*.prof

# Generated code
# *.pb.go — generated protobuf IS committed: module consumers cannot run protoc (dependency-resolution.md)
*_generated.go
vendor/

# Code coverage
coverage/
*.coverprofile

# Compiled test binaries
*.test

# CI/CD artifacts
.artifacts/

# Raft specific
raftwal/
snapshots/

# PebbleDB specific
*.sst
*.log
MANIFEST-*
OPTIONS-*
marker.*
CURRENT
LOCK

# Pebble/LSM test DBs leaked into the source tree (tests must use t.TempDir())
/pkg/server/data/
/pkg/server/vector/
/pkg/server/timeseries/

# Shared object binaries
*.so.*
.tmp/

# Staged local dependencies for Docker builds
.deps/

# Dockerized e2e artifacts
/test/e2e/.docker-results/

# Playwright run state and artifacts. .last-run.json records the status of the
# LAST run, so every `playwright test` rewrites it — a result, not source.
test-results/

# compiled binaries and node_modules never enter the module tree
/quicbaas
/quicbaasd
/registry
cmd/quicbaas/quicbaas
node_modules/

# example app runtime data (generated key stores; invalid zip paths)
examples/orchestration/*/data/

# Staged Gitea module-fetch credentials for container builds. Written outside
# the repo by default (see GOMODAUTH_ENV in the Makefile); this is the guard
# for anyone who points it at the working tree.
gomodauth*

# The frozen route-permission table is REQUIRED SOURCE, not a build
# artifact: consumers compile pkg/api/rest against it and nothing
# regenerates it in a module download. The v0.2.0-alpha module zip
# shipped without it (unbuildable with -tags rest) for exactly this
# reason — same failure mode as the v0.1.1-alpha gitignored *.pb.go.
!pkg/api/rest/routes_permissions_generated.go

# Python sidecar artifacts (sidecar/npu-embedding)
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
*.egg-info/
.venv/

# Build output of the integration cert-fixture tooling. A 5 MB unstripped ELF
# binary was tracked at the repository root from 47f0b37b until go-quicbaas#943;
# an unverifiable executable in a public repository is a supply-chain smell.
/gen-certs

# QuicBaaS Backup Credentials Configuration Example
#
# This file demonstrates how to configure multiple storage backend profiles
# for QuicBaaS backups. Place this file at ~/.quicbaas/backup-credentials.yaml
# or specify a custom location with --credentials-file flag.
#
# Environment variables can be referenced using ${VAR} or $VAR syntax.

# Profiles for different storage backends
profiles:

  # AWS S3 production profile
  production-s3:
    type: s3
    bucket: quicbaas-backups
    region: us-west-2
    credentials:
      access_key: ${AWS_ACCESS_KEY_ID}
      secret_key: ${AWS_SECRET_ACCESS_KEY}
      # Optional: session_token for temporary credentials
      # session_token: ${AWS_SESSION_TOKEN}
    config:
      # Optional: custom S3-compatible endpoint
      # endpoint: https://s3.example.com

  # Azure Blob Storage profile
  staging-azure:
    type: azure
    container: quicbaas-staging
    credentials:
      account_name: ${AZURE_STORAGE_ACCOUNT}
      account_key: ${AZURE_STORAGE_KEY}
      # Alternatively, use connection string:
      # connection_string: ${AZURE_STORAGE_CONNECTION_STRING}

  # Google Cloud Storage profile
  production-gcs:
    type: gcs
    bucket: quicbaas-gcs-backups
    credentials:
      # Path to GCP service account credentials JSON file
      credentials_file: ${GOOGLE_APPLICATION_CREDENTIALS}
    config:
      # Optional: GCP project ID
      project_id: my-gcp-project

  # MinIO profile (S3-compatible)
  local-minio:
    type: minio
    bucket: quicbaas-local
    region: us-east-1
    credentials:
      access_key: ${MINIO_ACCESS_KEY}
      secret_key: ${MINIO_SECRET_KEY}
    config:
      endpoint: localhost:9000
      # Optional: enable SSL/TLS
      use_ssl: false

  # Local filesystem profile
  local-dev:
    type: local
    config:
      base_path: /var/lib/quicbaas/backups

# Default profile to use when --profile is not specified
default_profile: production-s3

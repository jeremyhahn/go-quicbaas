{
  "name": "QuicBaaS Development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "USERNAME": "quicbaas",
      "USER_UID": "1000",
      "USER_GID": "1000"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true,
      "dockerDashComposeVersion": "v2"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        "go.gopath": "/home/quicbaas/go",
        "go.goroot": "/usr/local/go",
        "go.testFlags": ["-v", "-count=1"],
        "go.coverOnSave": true,
        "go.coverageDecorator": {
          "type": "gutter",
          "coveredHighlightColor": "rgba(64,128,128,0.5)",
          "uncoveredHighlightColor": "rgba(128,64,64,0.25)",
          "coveredGutterStyle": "blockgreen",
          "uncoveredGutterStyle": "blockred"
        },
        "go.lintTool": "golangci-lint",
        "go.lintFlags": ["--fast"],
        "go.formatTool": "gofmt",
        "go.buildTags": "integration,iam,l2_redis",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.watcherExclude": {
          "**/bin/**": true,
          "**/data/**": true,
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true
        }
      },
      "extensions": [
        "golang.go",
        "ms-azuretools.vscode-docker",
        "streetsidesoftware.code-spell-checker",
        "eamodio.gitlens",
        "yzhang.markdown-all-in-one",
        "redhat.vscode-yaml",
        "zxh404.vscode-proto3",
        "usernamehw.errorlens",
        "gruntfuggly.todo-tree"
      ]
    }
  },
  "containerEnv": {
    "GOPATH": "/home/quicbaas/go",
    "GOCACHE": "/home/quicbaas/.cache/go-build",
    "CGO_ENABLED": "0",
    "GO111MODULE": "on",
    "QUICBAAS_LOG_LEVEL": "debug",
    "QUICBAAS_LOG_FORMAT": "console",
    "QUICBAAS_DATA_DIR": "/data",
    "QUICBAAS_TEST_MODE": "development",
    "QUICBAAS_SERVER_ENABLE_REST": "true",
    "QUICBAAS_SERVER_ENABLE_TCP": "true",
    "QUICBAAS_SERVER_ENABLE_QUIC": "true",
    "QUICBAAS_SERVER_PORT": "8080",
    "QUICBAAS_SERVER_GRPC_PORT": "9090",
    "QUICBAAS_SERVER_QUIC_PORT": "4433",
    "QUICBAAS_SERVER_UNIX_SOCKET": "/tmp/quicbaas.sock",
    "OLLAMA_URL": "http://localhost:11434",
    "OLLAMA_HOST": "0.0.0.0:11434"
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "source=quicbaas-gomod-cache,target=/home/quicbaas/go/pkg/mod,type=volume",
    "source=quicbaas-gobuild-cache,target=/home/quicbaas/go/build,type=volume",
    "source=quicbaas-data,target=/data,type=volume"
  ],
  "workspaceFolder": "/workspace",
  "workspaceMount": "",
  "remoteUser": "quicbaas",
  "postCreateCommand": "go mod download && go build -tags 'iam,l2_redis' ./...",
  "postStartCommand": "git config --global --add safe.directory /workspace && /workspace/.devcontainer/start-ollama.sh && /workspace/.devcontainer/start-quicbaas.sh",
  "forwardPorts": [8080, 9090, 4433, 2345, 6379, 63000, 11434],
  "portsAttributes": {
    "8080": {
      "label": "REST API",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "9090": {
      "label": "gRPC API",
      "onAutoForward": "notify",
      "protocol": "https"
    },
    "4433": {
      "label": "QUIC",
      "onAutoForward": "silent"
    },
    "2345": {
      "label": "Delve Debugger",
      "onAutoForward": "silent"
    },
    "6379": {
      "label": "Redis",
      "onAutoForward": "silent"
    },
    "63000": {
      "label": "Raft",
      "onAutoForward": "silent"
    },
    "11434": {
      "label": "Ollama",
      "onAutoForward": "silent"
    }
  },
  "runArgs": [
    "--init",
    "--privileged"
  ],
  "hostRequirements": {
    "memory": "8gb",
    "cpus": 4
  }
}

# Ignore data directories
data/
./data
# Common nested data dirs
*/data
test/*/data
test/integration/data

# Ignore log directories
logs/
./logs
*/logs

# Ignore test coverage files
*.out
coverage.html

# Ignore IDE files
.vscode/
.idea/

# Ignore git
.git/
.gitignore

# Ignore Docker files
Dockerfile*
docker-compose*.yml
.dockerignore

# Dependencies are fetched via go mod download (no vendor directory)

# Local sibling-staging dir (legacy from .deps-based build, no longer used)
.deps/

# Test scratch dir + leftover test artifacts
.tmp/

# Build outputs (binaries are built inside the Docker image)
bin/
build/
dist/

# Coverage outputs
coverage/

# Local .log files (CI/test logs from prior runs)
*.log

# Frontend Node dependencies (rebuilt inside image when frontend is needed)
cmd/quicbaas/frontend/node_modules/
cmd/quicbaas/frontend/dist/

# Loose binaries left at project root from prior dev sessions
quicbaas
quicbaasd

# BuildKit module-fetch credentials are staged under RUNNER_TEMP, outside the
# build context. This is the second line of defence: if one is ever written
# into the workspace by mistake, COPY . . must not bake it into a layer.
gomodauth*

# The private development workflow never enters an image build context: the
# same list .gitattributes keeps out of every archive, enforced by
# pkg/labstrings (docs/release/public-releasability.md).
**/CLAUDE.md
**/AGENTS.md
**/.claude
**/.serena

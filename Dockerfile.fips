# QuicBaaS FIPS 140-3 Compliant Dockerfile
# Uses Go 1.24+ GOFIPS140 for FIPS-validated cryptography

# Build arguments
ARG GO_VERSION=1.27
ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown
ARG GOFIPS140=v1.0.0
# gms_pure_go is the floor, not a feature: this builder is CGO_ENABLED=0 and
# dolthub/go-mysql-server's internal/regex has no file satisfying
# `cgo && !gms_pure_go` without cgo, so the link fails on "build constraints
# exclude all Go files" (see Dockerfile's identical comment). release.yml
# never overrides BUILD_TAGS for this image, so this default is load-bearing.
ARG BUILD_TAGS=gms_pure_go

# Stage 1: Build stage with FIPS support
FROM golang:${GO_VERSION}-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    make \
    ca-certificates \
    file \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy module files first for caching
COPY go.mod go.sum ./
COPY sdk/go/go.mod sdk/go/go.sum ./sdk/go/

# Until 2026-08-14 this stage copied working-tree clones out of a .deps/
# directory and rewrote a set of relative `replace` directives to point at
# them (see Dockerfile's identical comment). Both are gone: .deps/ was
# deleted with the decoupling, and the only replaces left in go.mod are the
# intra-repo sdk/go one and an armon/go-metrics version pin, neither of which
# needs rewriting. The COPY of a directory that no longer exists failed the
# build outright.
#
# go.mod pins first-party modules published to the internal Gitea, which this
# download cannot reach on its own: the runner injects GOPRIVATE and the
# tokenised insteadOf rewrite into the *job* environment
# (dependency-resolution.md §6), and a docker build does not inherit it. They
# arrive as a BuildKit secret, never a build arg, mounted on tmpfs for this
# RUN alone and never becoming a layer. The mount is optional by design: on
# GitHub Actions no secret is supplied and these modules resolve from the
# public proxy once tags are mirrored (§7), so the same Dockerfile builds on
# both hosts.
RUN --mount=type=secret,id=gomodauth \
    set -eu; \
    if [ -f /run/secrets/gomodauth ]; then . /run/secrets/gomodauth; fi; \
    GONOSUMCHECK='*' go mod download

# Copy source code
COPY . .

# Build arguments
ARG VERSION
ARG COMMIT
ARG DATE
ARG GOFIPS140
ARG BUILD_TAGS

# Build static FIPS binaries using downloaded dependencies
# GOFIPS140=v1.0.0 enables FIPS 140-3 mode by default
RUN GOFIPS140=${GOFIPS140} CGO_ENABLED=0 GOOS=linux GONOSUMCHECK='*' go build -mod=mod -tags "${BUILD_TAGS}" -buildvcs=false \
    -ldflags="-w -s -X github.com/jeremyhahn/go-quicbaas/pkg/version.Version=${VERSION} -X github.com/jeremyhahn/go-quicbaas/pkg/version.BuildTime=${DATE} -X github.com/jeremyhahn/go-quicbaas/pkg/version.GitCommit=${COMMIT}" \
    -o quicbaasd ./cmd/quicbaasd

RUN GOFIPS140=${GOFIPS140} CGO_ENABLED=0 GOOS=linux GONOSUMCHECK='*' go build -mod=mod -tags "${BUILD_TAGS}" -buildvcs=false \
    -ldflags="-w -s -X github.com/jeremyhahn/go-quicbaas/pkg/version.Version=${VERSION} -X github.com/jeremyhahn/go-quicbaas/pkg/version.BuildTime=${DATE} -X github.com/jeremyhahn/go-quicbaas/pkg/version.GitCommit=${COMMIT}" \
    -o quicbaas ./cmd/quicbaas

# Verify static binaries
RUN echo "Verifying FIPS binaries:" && \
    file quicbaasd && \
    file quicbaas

# Stage 2: Runtime stage
# The binaries are static (CGO_ENABLED=0, FIPS comes from Go's crypto/fips140,
# not the OS), so the runtime needs only ca-certificates and tzdata. The
# debian:bookworm-slim base failed the release Trivy gate on 58 HIGH/CRITICAL
# base-layer CVEs (#591); this is the same base the daemon and CLI images use,
# which pass the identical gate. Pinned by tag and digest (the manifest-list
# digest of alpine:3.24.1, resolved 2026-10-11) so a scan is reproducible.
# Bump both together; `apk upgrade` covers the interval between base releases.
FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

# Install runtime dependencies, patched
RUN apk upgrade --no-cache && \
    apk --no-cache add ca-certificates tzdata

# Create non-root user
RUN addgroup -g 1000 quicbaas && \
    adduser -D -u 1000 -G quicbaas quicbaas

# Create directories
RUN mkdir -p /data /var/log/quicbaas /var/run/quicbaas && \
    chown -R quicbaas:quicbaas /data /var/log/quicbaas /var/run/quicbaas

# Copy binaries from builder
COPY --from=builder /build/quicbaasd /usr/local/bin/quicbaasd
COPY --from=builder /build/quicbaas /usr/local/bin/quicbaas

# Set ownership
RUN chown quicbaas:quicbaas /usr/local/bin/quicbaasd /usr/local/bin/quicbaas

# Switch to non-root user
USER quicbaas

# Set working directory
WORKDIR /data

# Expose ports
# 8080: HTTP/REST API
# 9090: gRPC API
# 63001-63010: Raft cluster communication
EXPOSE 8080 9090 63001-63010

# Health check using CLI
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD quicbaas --address /var/run/quicbaas/quicbaas.sock cluster status || exit 1

# Volume for data persistence
VOLUME ["/data"]

# Default environment variables
# GODEBUG=fips140=on ensures FIPS mode is enabled at runtime
ENV QUICBAAS_LOG_LEVEL=info \
    QUICBAAS_LOG_FORMAT=json \
    QUICBAAS_STORAGE_DATA_DIR=/data \
    QUICBAAS_SERVER_UNIX_SOCKET=/var/run/quicbaas/quicbaas.sock \
    GODEBUG=fips140=on

# Entry point - the daemon
ENTRYPOINT ["quicbaasd"]

# Default command - use config file if present
CMD ["--config", "/data/config.yaml"]

# Labels
LABEL org.opencontainers.image.title="QuicBaaS FIPS" \
      org.opencontainers.image.description="QuicBaaS with FIPS 140-3 compliance (Go crypto/fips140)" \
      org.opencontainers.image.vendor="QuicBaaS" \
      org.opencontainers.image.licenses="Apache-2.0" \
      security.fips.enabled="true" \
      security.fips.module="go-crypto-fips140"

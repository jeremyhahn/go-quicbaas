# QuicBaaS FIPS 140-3 Compliant Dockerfile
# Uses Go 1.24+ GOFIPS140 for FIPS-validated cryptography

# Build arguments
ARG GO_VERSION=1.26
ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown
ARG GOFIPS140=v1.0.0
ARG BUILD_TAGS=

# Stage 1: Build stage with FIPS support
FROM golang:${GO_VERSION}-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    make \
    ca-certificates \
    file \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy module files first for caching
COPY go.mod go.sum ./
COPY sdk/go/go.mod sdk/go/go.sum ./sdk/go/

# Copy local dependencies (staged by Makefile into .deps/)
COPY .deps/ /deps/

# Rewrite local replace directives to point to staged deps
RUN sed -i 's|=> /home/.*/go-quicraft|=> /deps/go-quicraft|g' go.mod sdk/go/go.mod && \
    sed -i 's|=> /home/.*/go-qrdb/sdk/go|=> /deps/go-qrdb/sdk/go|g' go.mod sdk/go/go.mod && \
    sed -i 's|=> /home/.*/go-qrdb$|=> /deps/go-qrdb|g' go.mod sdk/go/go.mod && \
    sed -i 's|=> /home/.*/go-xkms/sdk/go|=> /deps/go-xkms/sdk/go|g' go.mod sdk/go/go.mod && \
    sed -i 's|=> /home/.*/go-xkms$|=> /deps/go-xkms|g' go.mod sdk/go/go.mod

# Download remaining dependencies
RUN GONOSUMCHECK='*' go mod download

# Copy source code
COPY . .

# Rewrite replace directives again (COPY . . overwrites go.mod)
RUN sed -i 's|=> /home/.*/go-quicraft|=> /deps/go-quicraft|g' go.mod sdk/go/go.mod && \
    sed -i 's|=> /home/.*/go-qrdb/sdk/go|=> /deps/go-qrdb/sdk/go|g' go.mod sdk/go/go.mod && \
    sed -i 's|=> /home/.*/go-qrdb$|=> /deps/go-qrdb|g' go.mod sdk/go/go.mod && \
    sed -i 's|=> /home/.*/go-xkms/sdk/go|=> /deps/go-xkms/sdk/go|g' go.mod sdk/go/go.mod && \
    sed -i 's|=> /home/.*/go-xkms$|=> /deps/go-xkms|g' go.mod sdk/go/go.mod

# Build arguments
ARG VERSION
ARG COMMIT
ARG DATE
ARG GOFIPS140
ARG BUILD_TAGS

# Build static FIPS binaries using downloaded dependencies
# GOFIPS140=v1.0.0 enables FIPS 140-3 mode by default
RUN GOFIPS140=${GOFIPS140} CGO_ENABLED=0 GOOS=linux GONOSUMCHECK='*' go build -mod=mod -tags "${BUILD_TAGS}" -buildvcs=false \
    -ldflags="-w -s -X github.com/jeremyhahn/go-quicbaas/pkg/version.Version=${VERSION} -X github.com/jeremyhahn/go-quicbaas/pkg/version.BuildTime=${DATE} -X github.com/jeremyhahn/go-quicbaas/pkg/version.GitCommit=${COMMIT}" \
    -o quicbaasd ./cmd/quicbaasd

RUN GOFIPS140=${GOFIPS140} CGO_ENABLED=0 GOOS=linux GONOSUMCHECK='*' go build -mod=mod -tags "${BUILD_TAGS}" -buildvcs=false \
    -ldflags="-w -s -X github.com/jeremyhahn/go-quicbaas/pkg/version.Version=${VERSION} -X github.com/jeremyhahn/go-quicbaas/pkg/version.BuildTime=${DATE} -X github.com/jeremyhahn/go-quicbaas/pkg/version.GitCommit=${COMMIT}" \
    -o quicbaas ./cmd/quicbaas

# Verify static binaries
RUN echo "Verifying FIPS binaries:" && \
    file quicbaasd && \
    file quicbaas

# Stage 2: Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g 1000 quicbaas && \
    useradd -u 1000 -g quicbaas -s /bin/bash -m quicbaas

# Create directories
RUN mkdir -p /data /var/log/quicbaas /var/run/quicbaas && \
    chown -R quicbaas:quicbaas /data /var/log/quicbaas /var/run/quicbaas

# Copy binaries from builder
COPY --from=builder /build/quicbaasd /usr/local/bin/quicbaasd
COPY --from=builder /build/quicbaas /usr/local/bin/quicbaas

# Set ownership
RUN chown quicbaas:quicbaas /usr/local/bin/quicbaasd /usr/local/bin/quicbaas

# Switch to non-root user
USER quicbaas

# Set working directory
WORKDIR /data

# Expose ports
# 8080: HTTP/REST API
# 9090: gRPC API
# 63001-63010: Raft cluster communication
EXPOSE 8080 9090 63001-63010

# Health check using CLI
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD quicbaas --address /var/run/quicbaas/quicbaas.sock cluster status || exit 1

# Volume for data persistence
VOLUME ["/data"]

# Default environment variables
# GODEBUG=fips140=on ensures FIPS mode is enabled at runtime
ENV QUICBAAS_LOG_LEVEL=info \
    QUICBAAS_LOG_FORMAT=json \
    QUICBAAS_STORAGE_DATA_DIR=/data \
    QUICBAAS_SERVER_UNIX_SOCKET=/var/run/quicbaas/quicbaas.sock \
    GODEBUG=fips140=on

# Entry point - the daemon
ENTRYPOINT ["quicbaasd"]

# Default command - use config file if present
CMD ["--config", "/data/config.yaml"]

# Labels
LABEL org.opencontainers.image.title="QuicBaaS FIPS" \
      org.opencontainers.image.description="QuicBaaS with FIPS 140-3 compliance (Go crypto/fips140)" \
      org.opencontainers.image.vendor="QuicBaaS" \
      org.opencontainers.image.licenses="Apache-2.0" \
      security.fips.enabled="true" \
      security.fips.module="go-crypto-fips140"

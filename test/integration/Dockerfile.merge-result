# QuicBaaS merge-result snapshot test runner.

# Stage 1: compile the test binary.
FROM golang:1.27.4-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /workspace/go-quicbaas

# The test binary compiles here, so this stage's module cache must be warm.
COPY go.mod go.sum ./
COPY sdk/go/go.mod sdk/go/go.sum ./sdk/go/

# Module credentials arrive as a BuildKit secret on tmpfs, sourced for this run only, so the token reaches no layer or command line.
RUN --mount=type=secret,id=gomodauth \
    set -eu; \
    if [ -f /run/secrets/gomodauth ]; then set -a; . /run/secrets/gomodauth; set +a; fi; \
    go mod download

COPY . .

# Compiled at image build time, so a compile break fails the build.
ENV CGO_ENABLED=0 \
    GO111MODULE=on \
    GOFLAGS=-mod=readonly
RUN go test -tags integration -c -o /out/merge-result.test ./pkg/sdlc/

# Stage 2: the runtime, git and the suite that drives it.
FROM alpine:3.24.1

LABEL maintainer="Jeremy Hahn"
LABEL description="QuicBaaS merge-result snapshot integration test runner"

# git is the subject under test; the pinned base fixes its version.
RUN apk upgrade --no-cache && \
    apk add --no-cache git

COPY --from=builder /out/merge-result.test /usr/local/bin/merge-result.test

WORKDIR /tmp

# `docker run <image>` runs the snapshot suite; `-test.run X` narrows it.
ENTRYPOINT ["/usr/local/bin/merge-result.test"]
CMD ["-test.run", "TestSnapshotWorkTree", "-test.v", "-test.timeout=5m"]

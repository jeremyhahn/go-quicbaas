# Single-node QuicBaaS server image for the SDK integration suite.

ARG BUILD_TAGS="iam raft rest rag"

# Stage 1: build the binaries in a Go workspace.
FROM golang:1.27.4-alpine AS builder

ARG BUILD_TAGS

# Install build dependencies
RUN apk add --no-cache \
    git \
    make \
    bash \
    ca-certificates

WORKDIR /workspace/go-quicbaas

COPY go.mod go.sum ./
COPY sdk/go/go.mod sdk/go/go.sum ./sdk/go/

# Module credentials arrive as a BuildKit secret on tmpfs, sourced for this run only, so the token reaches no layer or command line.
RUN --mount=type=secret,id=gomodauth \
    set -eu; \
    if [ -f /run/secrets/gomodauth ]; then set -a; . /run/secrets/gomodauth; set +a; fi; \
    go mod download

COPY . .

# Remove deprecated debug route variants to avoid stale files in image cache.
RUN rm -f pkg/api/rest/debug_integration.go pkg/api/rest/debug_noop.go || true

# Build node + CLI.
RUN CGO_ENABLED=0 GOOS=linux \
    go build -tags "${BUILD_TAGS}" -buildvcs=false -ldflags "-w -s" -o bin/quicbaasd ./cmd/quicbaasd && \
    CGO_ENABLED=0 GOOS=linux \
    go build -tags "${BUILD_TAGS}" -buildvcs=false -ldflags "-w -s" -o bin/quicbaas ./cmd/quicbaas

# Stage 2: minimal runtime for the single-node SDK test server.
FROM alpine:latest

LABEL maintainer="Jeremy Hahn"
LABEL description="QuicBaaS SDK integration test single-node server"
LABEL version="2.0.0"

RUN apk add --no-cache \
    bash \
    curl \
    ca-certificates \
    tzdata \
    netcat-openbsd

RUN addgroup -g 1000 quicbaas && \
    adduser -D -u 1000 -G quicbaas -s /bin/bash quicbaas

RUN mkdir -p /data /var/log/quicbaas /var/run/quicbaas /etc/quicbaas && \
    chown -R quicbaas:quicbaas /data /var/log/quicbaas /var/run/quicbaas /etc/quicbaas

# Copy built binaries from the workspace builder stage.
COPY --from=builder /workspace/go-quicbaas/bin/quicbaasd /usr/local/bin/quicbaasd
COPY --from=builder /workspace/go-quicbaas/bin/quicbaas  /usr/local/bin/quicbaas

RUN chmod +x /usr/local/bin/quicbaasd /usr/local/bin/quicbaas

# Ports: 8080 REST, 9090 metrics, 50051 gRPC, 4433 QUIC, 63001-63010 Raft.
EXPOSE 8080 9090 50051 4433 63001-63010

VOLUME ["/data", "/var/log/quicbaas"]

# Default environment variables for the dev/SDK server.
ENV QUICBAAS_LOG_LEVEL=debug \
    QUICBAAS_LOG_FORMAT=console \
    QUICBAAS_DATA_DIR=/data \
    CGO_ENABLED=0

# A single-node server by default; the SDK compose overrides the command.
CMD ["/usr/local/bin/quicbaasd", "node"]

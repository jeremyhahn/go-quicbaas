# QuicBaaS Integration Test Node Dockerfile
# Used for running QuicBaaS cluster nodes in integration tests.
#
# Build model: a Go workspace (go.work) is reconstructed inside the image
# from sibling repos supplied via Docker BuildKit's `workspace` named
# context (see docker-compose.integration.yml). go.work is then the single
# source of truth for cross-module resolution — same model as local dev.
# No `.deps/` staging or replace-directive rewriting required.

ARG BUILD_TAGS="local quic raft rest rag timeseries vector qrdb_vector iam mcp hashicorpmetrics codec_json codec_yaml codec_toml codec_msgpack codec_bson codec_cbor codec_protobuf awss3 gcpstorage azureblob minio"

# ============================================================================
# Stage 1: Build binaries inside a Go workspace mirroring the host layout.
# ============================================================================
FROM golang:1.26.6-alpine AS builder

ARG BUILD_TAGS
# COVER: when set to "1", build the daemon with Go coverage instrumentation
# (-cover -coverpkg=.../pkg/server) so that running the daemon in the cluster
# emits coverage data to GOCOVERDIR. Production builds leave COVER empty and
# get an ordinary, uninstrumented binary.
ARG COVER=""

# Install build dependencies
RUN apk add --no-cache \
    git \
    make \
    bash \
    ca-certificates

WORKDIR /workspace

# Pull each sibling go-quicbaas needs from the workspace named context.
# The host go.work also references unrelated Layer 0 modules (go-frost,
# go-luks2, go-trusted-platform — the latter is 21GB) that we deliberately
# do not bring into Docker; the pruned go.work below covers what's used.
COPY --from=workspace go-libsignal  ./go-libsignal
COPY --from=workspace go-objstore   ./go-objstore
COPY --from=workspace go-qrdb       ./go-qrdb
COPY --from=workspace go-quicraft   ./go-quicraft
COPY --from=workspace go-signal     ./go-signal
COPY --from=workspace go-truststrap ./go-truststrap
COPY --from=workspace go-xkms       ./go-xkms
COPY --from=workspace go-codec      ./go-codec
COPY --from=workspace go-frost       ./go-frost

# go-quicbaas itself comes from the default context (project root).
COPY . ./go-quicbaas

# Pruned go.work — same shape as /mnt/vm-host-1/go.work on the host,
# trimmed to the modules we actually copy. Replace directives mirror the
# workspace-only v0.0.0 entries from the host file. Keeping go.work as the
# single source of truth means individual go.mod files do not need any
# Docker-specific replace shimming.
RUN { \
        echo 'go 1.26.5'; \
        echo ''; \
        echo 'use ('; \
        echo '	./go-libsignal'; \
        echo '	./go-objstore'; \
        echo '	./go-objstore/api/sdks/go'; \
        echo '	./go-qrdb'; \
        echo '	./go-qrdb/sdk/go'; \
        echo '	./go-quicbaas'; \
        echo '	./go-quicbaas/sdk/go'; \
        echo '	./go-quicraft'; \
        echo '	./go-signal'; \
        echo '	./go-xkms'; \
        echo '	./go-codec'; \
        echo '	./go-frost'; \
        echo '	./go-xkms/sdk/go'; \
        echo '	./go-xkms/xkey'; \
        echo ')'; \
        echo ''; \
        echo 'replace ('; \
        echo '	github.com/jeremyhahn/go-libsignal v0.0.0       => ./go-libsignal'; \
        echo '	github.com/jeremyhahn/go-objstore v0.0.0        => ./go-objstore'; \
        echo '	github.com/jeremyhahn/go-qrdb v0.0.0            => ./go-qrdb'; \
        echo '	github.com/jeremyhahn/go-qrdb/sdk/go v0.0.0     => ./go-qrdb/sdk/go'; \
        echo '	github.com/jeremyhahn/go-quicbaas v0.0.0        => ./go-quicbaas'; \
        echo '	github.com/jeremyhahn/go-quicbaas/sdk/go v0.0.0 => ./go-quicbaas/sdk/go'; \
        echo '	github.com/jeremyhahn/go-quicraft v0.0.0        => ./go-quicraft'; \
        echo '	github.com/jeremyhahn/go-signal v0.0.0          => ./go-signal'; \
        echo '	github.com/jeremyhahn/go-xkms v0.0.0            => ./go-xkms'; \
        echo '	github.com/jeremyhahn/go-codec v1.3.0          => ./go-codec'; \
        echo '	github.com/jeremyhahn/go-frost v0.1.4-alpha    => ./go-frost'; \
        echo '	github.com/jeremyhahn/go-frost v0.1.6-alpha    => ./go-frost'; \
        echo '	github.com/jeremyhahn/go-xkms/sdk/go v0.0.0     => ./go-xkms/sdk/go'; \
        echo '	github.com/jeremyhahn/go-objstore v0.1.4-alpha => ./go-objstore'; \
        echo '	github.com/jeremyhahn/go-xkms v0.2.2-alpha    => ./go-xkms'; \
        echo ')'; \
    } > go.work

WORKDIR /workspace/go-quicbaas

# Drop go.sum: workspace `use` directives resolve sibling modules locally,
# but go.sum still gets consulted and may be out of sync with workspace
# versions (e.g. an in-flight sibling change). Letting Go regenerate sums
# under workspace mode is the correct behavior here.
RUN rm -f go.sum sdk/go/go.sum

# Build node + CLI. go.work at /workspace/go.work resolves every sibling.
# When COVER=1 the daemon is built with coverage instrumentation scoped to
# pkg/server; -ldflags "-w -s" is dropped because stripping is incompatible
# with the coverage runtime's need to emit a meta-data file at exit.
RUN if [ "${COVER}" = "1" ]; then \
        echo "Building coverage-instrumented quicbaasd (-coverpkg=pkg/server, covermode=atomic)"; \
        CGO_ENABLED=0 GOOS=linux GOSUMDB=off GOFLAGS=-insecure \
        go build -cover -covermode=atomic \
            -coverpkg=github.com/jeremyhahn/go-quicbaas/pkg/server,github.com/jeremyhahn/go-quicbaas/cmd/quicbaasd \
            -tags "coverage ${BUILD_TAGS}" -o bin/quicbaasd ./cmd/quicbaasd; \
    else \
        CGO_ENABLED=0 GOOS=linux GOSUMDB=off GOFLAGS=-insecure \
        go build -tags "${BUILD_TAGS}" -ldflags "-w -s" -o bin/quicbaasd ./cmd/quicbaasd; \
    fi && \
    CGO_ENABLED=0 GOOS=linux GOSUMDB=off GOFLAGS=-insecure \
    go build -tags "${BUILD_TAGS}" -ldflags "-w -s" -o bin/quicbaas ./cmd/quicbaas

# ============================================================================
# Stage 2: Minimal runtime for cluster nodes
# ============================================================================
FROM alpine:latest

LABEL maintainer="QuicBaaS Team"
LABEL description="QuicBaaS integration test node"
LABEL version="1.0.0"

RUN apk add --no-cache \
    bash \
    curl \
    ca-certificates \
    tzdata \
    netcat-openbsd

RUN addgroup -g 1000 quicbaas && \
    adduser -D -u 1000 -G quicbaas -s /bin/bash quicbaas

RUN mkdir -p /data /var/log/quicbaas /var/run/quicbaas /etc/quicbaas /covdata && \
    chown -R quicbaas:quicbaas /data /var/log/quicbaas /var/run/quicbaas /etc/quicbaas /covdata && \
    chmod 0777 /covdata

# Copy built binaries from the workspace builder stage
COPY --from=builder /workspace/go-quicbaas/bin/quicbaasd /usr/local/bin/quicbaasd
COPY --from=builder /workspace/go-quicbaas/bin/quicbaas  /usr/local/bin/quicbaas

RUN chmod +x /usr/local/bin/quicbaasd /usr/local/bin/quicbaas

ENV QUICBAAS_LOG_LEVEL=info \
    QUICBAAS_LOG_FORMAT=json \
    QUICBAAS_DATA_DIR=/data \
    CGO_ENABLED=0

# Expose ports
# 8080: HTTP/REST API
# 9090: Metrics/Prometheus
# 50051: gRPC API
# 4433: QUIC
# 63001-63010: Raft cluster communication
EXPOSE 8080 9090 50051 4433 63001-63010

VOLUME ["/data", "/var/log/quicbaas"]

HEALTHCHECK --interval=5s --timeout=3s --start-period=15s --retries=10 \
    CMD curl -sf http://localhost:8080/api/v1/health/live >/dev/null || exit 1

CMD ["/usr/local/bin/quicbaasd", "node"]

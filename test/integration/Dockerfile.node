# QuicBaaS Integration Test Node Dockerfile
# Used for running QuicBaaS cluster nodes in integration tests.
#
# Build model: first-party dependencies resolve from Gitea as tagged modules,
# exactly as they do for `go build` on a developer machine and in every other
# job (dependency-resolution.md §1). go.mod is the single source of truth.
#
# Until 2026-08-14 this image copied nine sibling repos out of a `workspace`
# named build context (`../../..` on the host) and generated a go.work inside
# the image -- a model §2 abolished, which could not work on a CI runner and
# had rotted unnoticed (go-codec pinned at v1.3.0, go-frost listed twice at two
# versions), and which then deleted go.sum and built with GOSUMDB=off
# GOFLAGS=-insecure. What this image runs is unchanged; only module resolution
# moved.

ARG BUILD_TAGS="local quic raft rest rag timeseries vector qrdb_vector iam mcp hashicorpmetrics codec_json codec_yaml codec_toml codec_msgpack codec_bson codec_cbor codec_protobuf gms_pure_go awss3 gcpstorage azureblob minio"

# ============================================================================
# Stage 1: Build the node and CLI binaries.
# ============================================================================
FROM golang:1.27.4-alpine AS builder

ARG BUILD_TAGS
# COVER: when set to "1", build the daemon with Go coverage instrumentation
# (-cover -coverpkg=.../pkg/server) so that running the daemon in the cluster
# emits coverage data to GOCOVERDIR. Production builds leave COVER empty and
# get an ordinary, uninstrumented binary.
ARG COVER=""

# Install build dependencies
RUN apk add --no-cache \
    git \
    make \
    bash \
    ca-certificates

WORKDIR /workspace/go-quicbaas

COPY go.mod go.sum ./
COPY sdk/go/go.mod sdk/go/go.sum ./sdk/go/

# Gitea credentials arrive as a BuildKit secret, mounted on tmpfs for this RUN
# alone and sourced rather than exported, so the token reaches neither a layer,
# image metadata, nor a command line (dependency-resolution.md §6). The mount
# is optional, so the same Dockerfile builds against the public proxy.
RUN --mount=type=secret,id=gomodauth \
    set -eu; \
    if [ -f /run/secrets/gomodauth ]; then set -a; . /run/secrets/gomodauth; set +a; fi; \
    go mod download

COPY . .

# Build node + CLI. When COVER=1 the daemon is built with coverage
# instrumentation scoped to pkg/server; -ldflags "-w -s" is dropped because
# stripping is incompatible with the coverage runtime's need to emit a
# meta-data file at exit.
RUN if [ "${COVER}" = "1" ]; then \
        echo "Building coverage-instrumented quicbaasd (-coverpkg=pkg/server, covermode=atomic)"; \
        CGO_ENABLED=0 GOOS=linux \
        go build -cover -covermode=atomic \
            -coverpkg=github.com/jeremyhahn/go-quicbaas/pkg/server,github.com/jeremyhahn/go-quicbaas/cmd/quicbaasd \
            -tags "coverage ${BUILD_TAGS}" -o bin/quicbaasd ./cmd/quicbaasd; \
    else \
        CGO_ENABLED=0 GOOS=linux \
        go build -tags "${BUILD_TAGS}" -ldflags "-w -s" -o bin/quicbaasd ./cmd/quicbaasd; \
    fi && \
    CGO_ENABLED=0 GOOS=linux \
    go build -tags "${BUILD_TAGS}" -ldflags "-w -s" -o bin/quicbaas ./cmd/quicbaas

# ============================================================================
# Stage 2: Minimal runtime for cluster nodes
# ============================================================================
FROM alpine:latest

LABEL maintainer="QuicBaaS Team"
LABEL description="QuicBaaS integration test node"
LABEL version="1.0.0"

RUN apk add --no-cache \
    bash \
    curl \
    ca-certificates \
    tzdata \
    netcat-openbsd \
    openssl

RUN addgroup -g 1000 quicbaas && \
    adduser -D -u 1000 -G quicbaas -s /bin/bash quicbaas

RUN mkdir -p /data /var/log/quicbaas /var/run/quicbaas /etc/quicbaas /covdata && \
    chown -R quicbaas:quicbaas /data /var/log/quicbaas /var/run/quicbaas /etc/quicbaas /covdata && \
    chmod 0777 /covdata

# Copy built binaries from the workspace builder stage
COPY --from=builder /workspace/go-quicbaas/bin/quicbaasd /usr/local/bin/quicbaasd
COPY --from=builder /workspace/go-quicbaas/bin/quicbaas  /usr/local/bin/quicbaas

COPY test/integration/node-entrypoint.sh /usr/local/bin/node-entrypoint.sh

RUN chmod +x /usr/local/bin/quicbaasd /usr/local/bin/quicbaas /usr/local/bin/node-entrypoint.sh

# The node config is tracked, so it is baked in rather than bind-mounted. A
# bind source is a path in the *host* daemon's filesystem, and this compose is
# driven from a job container whose workspace the host cannot see -- Docker then
# creates an empty directory at the source and the daemon starts with
# "read /etc/quicbaas/quicbaas.yaml: is a directory". Per-run *generated*
# material (the mTLS/PIV certs) comes from the certs-init service through a
# named volume instead; named volumes are daemon-side objects and work the same
# on a runner and a laptop.
COPY test/integration/quicbaas.yaml /etc/quicbaas/quicbaas.yaml

ENV QUICBAAS_LOG_LEVEL=info \
    QUICBAAS_LOG_FORMAT=json \
    QUICBAAS_DATA_DIR=/data \
    CGO_ENABLED=0

# Expose ports
# 8080: HTTP/REST API
# 9090: Metrics/Prometheus
# 50051: gRPC API
# 4433: QUIC
# 63001-63010: Raft cluster communication
EXPOSE 8080 9090 50051 4433 63001-63010

VOLUME ["/data", "/var/log/quicbaas"]

HEALTHCHECK --interval=5s --timeout=3s --start-period=15s --retries=10 \
    CMD curl -sf http://localhost:8080/api/v1/health/live >/dev/null || exit 1

# The entrypoint derives the Raft member identities go-quicraft requires from the
# peers' certificates, then execs the command.
ENTRYPOINT ["/usr/local/bin/node-entrypoint.sh"]
CMD ["/usr/local/bin/quicbaasd", "node"]

# QuicBaaS sandboxed ACP agent image (opencode + ollama provider).
#
# This is the image the embedded agent's container-sandbox spawn path launches
# as a SIBLING container for each session when QUICBAAS_E2E_SANDBOX=1. The
# daemon runs it as:
#
#   docker run -i --rm --network host --user <uid:gid> \
#     --workdir /workspace -e HOME=/tmp --entrypoint "" \
#     <this-image> opencode acp
#
# (see pkg/orchestration/acp_backend.go: spawnContainerJSONRPC). So the image
# only needs `opencode` on PATH plus a baked provider config that points at the
# remote ollama GPU host. The config is baked (not bind-mounted) because the
# sibling container is created by the HOST docker daemon — a bind mount from
# inside the e2e container would resolve against the host filesystem, not the
# files the e2e container wrote.
#
# Build (done by the Makefile test-e2e-acp-docker target with QUICBAAS_E2E_SANDBOX=1):
#   docker build -f test/e2e/Dockerfile.sandbox-agent \
#     --build-arg OLLAMA_URL=http://198.51.100.91:11434 \
#     --build-arg OPENCODE_MODEL=qwen3:1.7b \
#     -t quicbaas-e2e-sandbox-agent:latest test/e2e
#
# --network host lets the sibling reach the LAN GPU host (198.51.100.91:11434)
# via the docker host's own network namespace.

FROM node:22-bookworm-slim

ARG OLLAMA_URL=http://127.0.0.1:11434
ARG OPENCODE_MODEL=qwen3:1.7b

RUN npm install -g opencode-ai \
    && opencode --version

# Bake the opencode provider config that routes the model through the remote
# ollama OpenAI-compatible API (/v1). The daemon forces HOME=/tmp on the
# container and runs as an arbitrary host uid:gid, so write the config to every
# plausible $HOME and make it world-readable. ($schema is intentionally omitted
# to keep the heredoc free of shell-expansion escaping.)
RUN set -eux; \
    BASE="${OLLAMA_URL%/}/v1"; \
    for d in /tmp/.config/opencode /root/.config/opencode /home/agent/.config/opencode; do \
      mkdir -p "$d"; \
      printf '{\n  "provider": {\n    "ollama": {\n      "npm": "@ai-sdk/openai-compatible",\n      "name": "Ollama (remote GPU)",\n      "options": { "baseURL": "%s" },\n      "models": { "%s": { "name": "%s" } }\n    }\n  }\n}\n' \
        "$BASE" "$OPENCODE_MODEL" "$OPENCODE_MODEL" > "$d/opencode.json"; \
    done; \
    chmod -R a+rX /tmp/.config /root/.config /home/agent/.config

# Default HOME; the daemon overrides this to /tmp at spawn time anyway.
ENV HOME=/tmp
WORKDIR /workspace

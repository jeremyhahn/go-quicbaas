# QuicBaaS Agent Daemon systemd Unit
#
# Install to /etc/systemd/system/quicbaas-agent.service
#
# Setup steps:
#   1. Create user:
#      sudo useradd -r -s /bin/false -d /var/lib/quicbaas-agent -m quicbaas-agent
#   2. Copy unit file:
#      sudo cp quicbaas-agent.service /etc/systemd/system/
#   3. Install the daemon's mTLS identity into the credentials directory.
#      The daemon authenticates to the server with a client certificate
#      issued by the server's CA -- there is no bootstrap token:
#        /var/lib/quicbaas-agent/agent.crt      client certificate
#        /var/lib/quicbaas-agent/agent.key      private key, mode 0600
#        /var/lib/quicbaas-agent/server-ca.crt  CA bundle for --server
#      These are the same three filenames `quicbaas agent deploy` uploads,
#      so a host provisioned either way looks identical.
#   4. Write the environment file. agent.env.sample in this directory is
#      the annotated template; each entry names the `agent serve` flag it
#      feeds:
#      sudo mkdir -p /etc/quicbaas
#      sudo install -m 0640 -o root -g quicbaas-agent \
#        agent.env.sample /etc/quicbaas/agent.env
#      sudoedit /etc/quicbaas/agent.env
#   5. Enable and start:
#      sudo systemctl daemon-reload
#      sudo systemctl enable quicbaas-agent
#      sudo systemctl start quicbaas-agent
#   6. Verify:
#      sudo systemctl status quicbaas-agent
#      sudo journalctl -u quicbaas-agent -f

[Unit]
Description=QuicBaaS Remote Agent Daemon
Documentation=https://quicbaas.dev/docs/agents/daemon
After=network-online.target docker.service
Wants=network-online.target

# Start-rate limit. These are [Unit] properties: systemd has ignored them
# in [Service] since v230, which is how this unit previously ended up with
# no effective limit and an unbounded restart loop.
#
# The daemon waits out a control plane that is merely unreachable on its
# own (capped exponential backoff, see --enroll-retry-base), so a process
# that still exits is reporting something restarting cannot fix. Five
# starts inside five minutes and the unit lands in "failed", where
# monitoring sees it, instead of "activating (auto-restart)" forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=quicbaas-agent
Group=quicbaas-agent

# Work directory for session state, credentials, logs
WorkingDirectory=/var/lib/quicbaas-agent

# SystemD creates and owns this directory with mode 0700
StateDirectory=quicbaas-agent

# Load configuration from environment file
# File format: KEY=value (one per line)
#
# Required (the daemon refuses to start without them):
#   QUICBAAS_SERVER=https://quicbaas.example.com:8443
#   QUICBAAS_TENANT=acme
#
# Optional -- each falls back to the default shown in ExecStart below:
#   QUICBAAS_BIND_ADDR=0.0.0.0:9091
#   QUICBAAS_BACKENDS=acp,ollama
#   QUICBAAS_SANDBOX_POLICY=required
#   QUICBAAS_CONTAINER_RUNTIME=auto
#   QUICBAAS_AGENT_CERT=/var/lib/quicbaas-agent/agent.crt
#   QUICBAAS_AGENT_KEY=/var/lib/quicbaas-agent/agent.key
#   QUICBAAS_SERVER_CA=/var/lib/quicbaas-agent/server-ca.crt
#
# Optional -- the flag is omitted entirely when the variable is unset:
#   QUICBAAS_SANDBOX_NETWORK=bridge
#   QUICBAAS_ALLOWED_MOUNT_ROOTS=/srv/agent-workspaces
#   QUICBAAS_AUTO_PULL=1
#   QUICBAAS_IMAGE_MAP=claude-code=quicbaas/claude-code:v1
#   QUICBAAS_IMAGE_REGISTRY=ghcr.io/automatethethings
#   QUICBAAS_MCP_ENDPOINT=https://quicbaas.example.com:8443/mcp
#   QUICBAAS_HEARTBEAT_INTERVAL=30s
EnvironmentFile=/etc/quicbaas/agent.env

# Daemon command line.
#
# Every flag below exists on `quicbaas agent serve`; the drift test in
# cmd/quicbaas checks that against the live cobra command, because a unit
# naming a removed flag fails at exec with "unknown flag" and then loops
# on the restart policy above until the start limit trips.
#
# The invocation runs under /bin/sh because ${VAR:-default} and
# ${VAR:+--flag "$VAR"} are shell expansions, not systemd ones. Each $ is
# written $$ so systemd passes the reference through literally and the
# shell -- which has supported both forms since forever -- does the
# expansion, rather than depending on the substitution systemd added in
# v249. `exec` replaces the shell so the daemon is the unit's main
# process and receives SIGTERM directly on `systemctl stop`.
ExecStart=/bin/sh -c 'exec /usr/local/bin/quicbaas agent serve \
  --server "$${QUICBAAS_SERVER}" \
  --tenant "$${QUICBAAS_TENANT}" \
  --bind "$${QUICBAAS_BIND_ADDR:-0.0.0.0:9091}" \
  --backends "$${QUICBAAS_BACKENDS:-acp,ollama}" \
  --sandbox-policy "$${QUICBAAS_SANDBOX_POLICY:-required}" \
  --container-runtime "$${QUICBAAS_CONTAINER_RUNTIME:-auto}" \
  --agent-cert "$${QUICBAAS_AGENT_CERT:-/var/lib/quicbaas-agent/agent.crt}" \
  --agent-key "$${QUICBAAS_AGENT_KEY:-/var/lib/quicbaas-agent/agent.key}" \
  --server-ca "$${QUICBAAS_SERVER_CA:-/var/lib/quicbaas-agent/server-ca.crt}" \
  --work-dir /var/lib/quicbaas-agent/work \
  $${QUICBAAS_SANDBOX_NETWORK:+--sandbox-network "$${QUICBAAS_SANDBOX_NETWORK}"} \
  $${QUICBAAS_ALLOWED_MOUNT_ROOTS:+--allowed-mount-root "$${QUICBAAS_ALLOWED_MOUNT_ROOTS}"} \
  $${QUICBAAS_AUTO_PULL:+--auto-pull} \
  $${QUICBAAS_IMAGE_MAP:+--image-map "$${QUICBAAS_IMAGE_MAP}"} \
  $${QUICBAAS_IMAGE_REGISTRY:+--image-registry "$${QUICBAAS_IMAGE_REGISTRY}"} \
  $${QUICBAAS_MCP_ENDPOINT:+--mcp-endpoint "$${QUICBAAS_MCP_ENDPOINT}"} \
  $${QUICBAAS_HEARTBEAT_INTERVAL:+--heartbeat-interval "$${QUICBAAS_HEARTBEAT_INTERVAL}"}'

# Restart policy: automatic restart on failure (not after clean exit),
# with an escalating delay so a persistent failure does not hammer the
# host or the control plane. RestartSteps / RestartMaxDelaySec need
# systemd >= 254; older versions log "Unknown key name", fall back to the
# flat RestartSec, and are still bounded by the StartLimit* pair above.
Restart=on-failure
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=120s

# Graceful shutdown: give sessions 30 seconds to drain
TimeoutStopSec=60s

# Standard output and error to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quicbaas-agent

# Security hardening
NoNewPrivileges=yes

# Mount /var/run/docker.sock (for nested container spawn)
# CAUTION: This grants the daemon permission to spawn containers.
# Only use with trusted host configurations.
#
# BindPaths= takes only "rbind"/"norbind" as its option string: the ":rw"
# this line used to carry made systemd log "Invalid option string" and drop
# the setting, so the socket was never bound at all. Bind mounts are
# writable by default, so no option string is needed. The leading "-"
# skips the mount when the socket is absent (podman hosts, container
# runtime "none") instead of failing the unit.
BindPaths=-/var/run/docker.sock:/var/run/docker.sock

# Filesystem: strict read-only except state directory
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/quicbaas-agent

# Restrict network to localhost and specified server (not enforced by systemd)
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# Lock down capabilities: drop all, grant none
CapabilityBoundingSet=
AmbientCapabilities=

# Memory and CPU limits (optional; adjust per host specs)
# MemoryMax=1G
# CPUQuota=100%

[Install]
WantedBy=multi-user.target

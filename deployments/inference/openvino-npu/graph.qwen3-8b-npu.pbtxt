# OVMS mediapipe graph for Qwen3-8B-int4-cw-ov on an Intel NPU.
#
# Copy this to the served model directory as graph.pbtxt (beside
# openvino_model.xml) and restart the OVMS container. OVMS generates a default
# graph when none is present, and that default caps the prompt at the NPU
# plugin's 1024-token default -- which is smaller than the SDLC triage charter
# alone, so every triage turn failed with:
#
#   Mediapipe execution failed ... "Input length exceeds the maximum allowed
#   length"
#
# THE KEY IS MAX_PROMPT_LEN, UNPREFIXED, AND IT GOES IN plugin_config.
# Three spellings were measured on OVMS 2026.3.1 (2026-09-16):
#   - `max_prompt_len` as a node_options FIELD: refused at load,
#     "Message type mediapipe.LLMCalculatorOptions has no field named
#     max_prompt_len" -- the server exits 1 and serves nothing.
#   - `NPUW_LLM_MAX_PROMPT_LEN` alone in plugin_config: loads, recompiles for
#     several minutes, and the limit does NOT move. It is a real NPU plugin
#     property and it is not the one this pipeline reads.
#   - `MAX_PROMPT_LEN` in plugin_config: works. Measured at 32768, 20,009
#     prompt tokens accepted where 1,109 previously failed; at the 8192 set
#     below, 7,509 accepted.
# Both are set below; the NPUW_ pair is harmless and documents the mapping.
#
# COST: THE NPU RESERVES FOR THE MAXIMUM, USED OR NOT. The plugin compiles a
# STATIC shape, so this is a memory decision as much as a correctness one, and
# the reservation is SHARED memory -- invisible to `ps` and to every
# top-by-RSS reading of the machine. Read it with `free -h` (shared column),
# `grep Shmem /proc/meminfo`, or `docker stats`.
#
# THE CURVE IS SUPERLINEAR -- roughly a doubling per 8K step, NOT the straight
# line a first reading of two points suggests:
#
#     MAX_PROMPT_LEN   reserved (Shmem)   load      memory pressure
#          8192           11.8 GiB         45 s      none
#         16384           17.9 GiB         79 s      PSI full avg60 0.15%
#         24576           31.4 GiB        191 s      PSI full avg60 9.22%, free <1 GiB
#         32768           63.7 GiB         ~7 min    host swapped, desktop unusable
#
# 24576 is where it visibly turns: for 9% of that minute EVERY task on the box
# was stalled on memory. Keep the reservation at or under ~20 GiB.
#
# A LARGER SHAPE IS FREE IN LATENCY, WHICH IS WHY 16384 RATHER THAN 8192.
# Prefill tracks the ACTUAL prompt length, not the compiled shape: the same
# 5,886-token prompt took 35.4 s at 8192, 35.5 s at 16384 and 35.8 s at 24576.
# The larger shape costs memory and one-time load, and nothing per request --
# and 8192 leaves no room for a 7,500-token prompt once the system message and
# the answer budget are added.
#
# THIS MODEL IS THE CEILING ON THIS NPU. Only seven `-int4-cw-ov` models exist
# and Qwen3-8B is the largest. The plain `-int4-ov` builds (which include 14B
# models) store weights as asymmetric `u4` with per-group zero points, and the
# NPU37XX compiler cannot lower that dequantize -- measured, both a 1.7B and a
# 14B failed identically with "Unsupported DequantizeOp configuration ...
# quant.uniform<u4:f16>". It is structural, not a tuning problem. The `-cw`
# builds store symmetric channel-wise `i4`, which compiles.
#
# WHETHER TO USE THE NPU AT ALL: for interactive triage, no. One 5,886-token
# turn costs ~72 s here (35 s prefill at 166 tok/s, 37 s decode at 6 tok/s)
# against ~4 s for a 27B on a discrete GPU -- about 18x slower for a model a
# third the size, with no way to buy back quality because the toolchain rejects
# everything larger. What it does buy is power: ~14 W package against ~106 W on
# the GPU, at ~100% NPU residency. That is the case for it, and it is the only
# one. The verdicts it gives ARE correct; `/no_think` is required, or Qwen3
# spends the whole answer budget reasoning and returns nothing.
#
# An iGPU is NOT automatically the cheaper answer: integrated graphics have no
# dedicated VRAM and draw on the same system memory. What differs is that the
# GPU plugin sizes a KV cache dynamically (`cache_size`) instead of compiling a
# static shape, so memory tracks use. It needs the Intel GPU compute runtime in
# the image, which the Dockerfile beside this file does not install -- with the
# render node passed through but no runtime, OpenVINO still reports only
# "CPU, NPU" and a GPU graph fails at load.

# File created with: OpenVINO Model Server 2026.3.1.3a28d490b
# OVMS_GRAPH_QUEUE_MAX_SIZE: AUTO

    input_stream: "HTTP_REQUEST_PAYLOAD:input"
    output_stream: "HTTP_RESPONSE_PAYLOAD:output"
    node: {
    name: "LLMExecutor"
    calculator: "HttpLLMCalculator"
    input_stream: "LOOPBACK:loopback"
    input_stream: "HTTP_REQUEST_PAYLOAD:input"
    input_side_packet: "LLM_NODE_RESOURCES:llm"
    input_side_packet: "LLM_NODE_EXECUTION_CONTEXTS:llm_ctx"
    output_stream: "LOOPBACK:loopback"
    output_stream: "HTTP_RESPONSE_PAYLOAD:output"
    input_stream_info: {
        tag_index: 'LOOPBACK:0',
        back_edge: true
    }
    node_options: {
        [type.googleapis.com / mediapipe.LLMCalculatorOptions]: {
            device: "NPU",
              max_num_seqs:1,
            plugin_config: "{\"MAX_PROMPT_LEN\": 16384, \"MIN_RESPONSE_LEN\": 512, \"NPUW_LLM_MAX_PROMPT_LEN\": 16384, \"NPUW_LLM_MIN_RESPONSE_LEN\": 512}",
            models_path: "./",
            enable_prefix_caching: false,
            cache_size: 0,
        }
    }
    input_stream_handler {
        input_stream_handler: "SyncSetInputStreamHandler",
        options {
        [mediapipe.SyncSetInputStreamHandlerOptions.ext] {
            sync_set {
            tag_index: "LOOPBACK:0"
            }
        }
        }
    }
    }
